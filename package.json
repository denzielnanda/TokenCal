{
  "name": "tokencal",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first token costs and usage limits in your menu bar.",
  "author": "TokenCal contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "node scripts/smoke.mjs",
    "check": "npm run test && npm run build",
    "dist:mac": "npm run build && node scripts/package-mac.mjs",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64 --arm64",
    "dist:dir": "npm run build && electron-builder --dir",
    "icons": "node scripts/generate-icons.mjs"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "org.tokencal.desktop",
    "productName": "TokenCal",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "TokenCal-${version}-mac-${arch}.${ext}",
      "minimumSystemVersion": "14.0",
      "extraResources": [
        {
          "from": "native/bin/notch-info",
          "to": "notch-info"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "TokenCal-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "TokenCal-${version}-windows-setup.${ext}"
    },
    "dmg": {
      "title": "TokenCal ${version}",
      "backgroundColor": "#171a21"
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module"
}
